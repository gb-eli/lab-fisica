  "session": {
    "storage": "localStorage",
    "fields": [
      "name",
      "className",
      "shift"
    ],
    "shifts": [
      "manha",
      "tarde",
      "noite"
    ],
    "exports": [
      "json",
      "csv"
    ],
    "tracks": [
      "visits",
      "activeSeconds",
      "firstOpenedAt",
      "lastOpenedAt",
      "learningMode",
      "mentorId",
      "mentorSteps",
      "hintsUsed"
    ]
  },
  "cache": {
    "shell": "install-time",
    "laboratories": "runtime-on-demand",
    "clearable": true,
    "memoryReleasedOnExit": true,
    "persistentCacheRetainedByDefault": true
  },
  "optionalModules": {
    "mentorGuided": {
      "loadPolicy": "on-user-selection",
      "defaultLoaded": false,
      "module": "js/mentors/mentor-controller.js",
      "style": "css/mentor-guided.css",
      "dependencies": [
        "js/mentors/mentor-catalog.js",
        "js/mentors/tracks/core-tracks.js",
        "js/mentors/highlight-engine.js",
        "js/mentors/step-validator.js"
      ],
      "supportedRoutes": [
        "coulomb",
        "ohm",
        "mechanics"
      ],
      "loadTrigger": "explicit mentor selection",
      "mentors": 6,
      "routes": 8,
      "tracks": 33,
      "steps": 138
    }
  }
